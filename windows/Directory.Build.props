<Project>
  <PropertyGroup>
    <Version>0.3.11</Version>
    <LangVersion>15.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- SDK 11.0.100 omits 28000; stop overriding once the SDK declares it. -->
  <ItemGroup>
    <WindowsSdkSupportedTargetPlatformVersion Include="10.0.28000.0" WindowsSdkPackageVersion="10.0.28000.87" MinimumNETVersion="11.0" Condition="'@(WindowsSdkSupportedTargetPlatformVersion->WithMetadataValue('Identity', '10.0.28000.0'))@(WindowsSdkSupportedTargetPlatformVersion->WithMetadataValue('Identity', '10.0.28000.1'))' == ''" />
  </ItemGroup>
</Project>
