<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net11.0-windows10.0.28000.0</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- SDK 11.0.100 lacks this stable target; remove when the SDK lists 28000. -->
  <ItemGroup>
    <WindowsSdkSupportedTargetPlatformVersion Include="10.0.28000.0" WindowsSdkPackageVersion="$(WindowsSdkPackageVersion)" MinimumNETVersion="11.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../ByoGlot.Core/ByoGlot.Core.csproj" />
    <Compile Include="../ByoGlot.App/Services/HttpClientTransport.cs" Link="Services/HttpClientTransport.cs" />
    <Compile Include="../ByoGlot.App/Services/FileSettingsRepository.cs" Link="Services/FileSettingsRepository.cs" />
    <Using Include="Xunit" />
    <Using Include="ByoGlot.Core" />
    <Using Include="ByoGlot.App.Services" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <Compile Include="../ByoGlot.App/Services/DpapiSecretStore.cs" Link="Services/DpapiSecretStore.cs" />
  </ItemGroup>
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))"><Compile Remove="DpapiSecretStoreTests.cs" /></ItemGroup>
</Project>
