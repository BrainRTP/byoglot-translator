    "providers.firstBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation is done by your chosen provider's model using your API key. Requests go straight to the provider; the key stays on this device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод делает модель выбранного провайдера по вашему API-ключу. Запросы идут напрямую провайдеру, ключ хранится только на этом устройстве."
          }
        }
      }
    },
