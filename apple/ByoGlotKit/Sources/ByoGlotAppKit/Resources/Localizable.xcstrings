{
  "sourceLanguage": "en",
  "strings": {
    "Add a provider in ByoGlot first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a provider in ByoGlot first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавьте провайдера в ByoGlot."
          }
        }
      }
    },
    "Choose a model in ByoGlot.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a model in ByoGlot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите модель в ByoGlot."
          }
        }
      }
    },
    "The API key for this provider is missing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key for this provider is missing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого провайдера не задан API-ключ."
          }
        }
      }
    },
    "Confirm in ByoGlot that text may be sent to %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm in ByoGlot that text may be sent to %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите в ByoGlot отправку текста на %@."
          }
        }
      }
    },
    "Unlock the device first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the device first."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала разблокируйте устройство."
          }
        }
      }
    },
    "The text is longer than %lld characters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is longer than %lld characters."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст длиннее %lld символов."
          }
        }
      }
    },
    "There is no text to translate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no text to translate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет текста для перевода."
          }
        }
      }
    },
    "The provider did not answer. Check the connection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider did not answer. Check the connection."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Провайдер не ответил. Проверьте соединение."
          }
        }
      }
    },
    "The provider rejected the API key (HTTP %lld).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider rejected the API key (HTTP %lld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Провайдер отклонил API-ключ (HTTP %lld)."
          }
        }
      }
    },
    "The provider limit is reached. Try again later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider limit is reached. Try again later."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут лимит провайдера. Повторите позже."
          }
        }
      }
    },
    "The provider returned an error: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider returned an error: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Провайдер вернул ошибку: %@"
          }
        }
      }
    },
    "ByoGlot cannot access shared storage.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ByoGlot cannot access shared storage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ByoGlot не может открыть общее хранилище."
          }
        }
      }
    },
    "providers.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Providers"
