<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <WindowsSdkPackageVersion Condition="'$(NETCoreSdkVersion)' == '11.0.100' and '$(WindowsSdkPackageVersion)' == ''">10.0.28000.87</WindowsSdkPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.371" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>
</Project>
