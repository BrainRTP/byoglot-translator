      "name": "deepseek with effort high",
      "input": {
        "provider": {
          "preset": "deepseek",
          "name": "DeepSeek",
          "baseUrl": "https://api.deepseek.com",
          "apiKey": "fixture-key"
        },
        "model": {
          "providerID": "deepseek",
          "id": "deepseek-flash",
          "variant": "high"
        },
        "prompt": "Translate hello to Russian.",
        "response": {
          "status": 200,
          "headers": {},
          "body": {
            "choices": [
              {
                "message": {
                  "content": "Привет"
                }
              }
            ]
          }
        }
      },
      "expected": {
        "request": {
          "method": "POST",
          "url": "https://api.deepseek.com/chat/completions",
          "headers": {
            "authorization": "Bearer fixture-key",
            "content-type": "application/json"
          },
          "body": {
            "model": "deepseek-flash",
            "messages": [
              {
                "role": "user",
                "content": "Translate hello to Russian."
              }
            ],
            "stream": false,
            "reasoning_effort": "high"
          }
        },
        "result": {
          "content": "Привет"
        }
      }
    },
