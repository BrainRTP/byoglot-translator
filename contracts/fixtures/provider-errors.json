        },
        "response": {
          "status": 429,
          "headers": {
            "Retry-After": " 30 "
          },
          "body": {}
        }
      },
      "expected": {
        "kind": "rate_limit",
        "status": 429,
        "retryAfterMs": 30000
      }
    },
    {
      "name": "429 with negative Retry-After",
      "input": {
        "provider": {
          "preset": "deepseek",
          "name": "DeepSeek",
          "baseUrl": "https://api.deepseek.com",
          "apiKey": "fixture-key"
        },
        "response": {
          "status": 429,
